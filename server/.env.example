AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGENT_GREETING=JARVIS online. How can I help?
PORT=8000

# Fish Audio voice: https://fish.audio/m/7c1a7dc37829497593ab4db29eed387c/
FISH_AUDIO_API_KEY=your_fish_audio_api_key
FISH_AUDIO_REFERENCE_ID=7c1a7dc37829497593ab4db29eed387c
FISH_AUDIO_BACKEND=s2.1-pro

# Agora calls this public OpenAI-compatible endpoint for the LLM stage.
CUSTOM_LLM_URL=https://your-railway-domain.up.railway.app/chat/completions
CUSTOM_LLM_PROXY_KEY=replace-with-a-long-random-secret

# Upstream model credentials stay only in the Python backend.
# This deployment uses Zhipu's OpenAI-compatible GLM endpoint.
LLM_API_KEY=your_zhipu_api_key
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.5-flash
LLM_THINKING_TYPE=disabled

# Notion API 2025-09-03 uses a data source ID rather than a database ID.
NOTION_API_KEY=your_notion_internal_integration_token
NOTION_DATA_SOURCE_ID=your_notion_data_source_id
NOTION_TITLE_PROPERTY=Name

MAX_ACTIVE_SESSIONS=3
CORS_ORIGINS=http://localhost:3000
